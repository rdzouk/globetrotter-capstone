# Copy to .env (same directory as docker-compose.yml) and fill in real values.
# Never commit .env itself.

JWT_SECRET=CHANGE_ME_generate_with_python_secrets_token_hex_32

POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=CHANGE_ME_use_a_real_password
POSTGRES_DB=globetrotter

# Your real domain(s), comma-separated, no trailing slash:
CORS_ORIGINS=https://yourdomain.com

LOG_LEVEL=INFO
GOOGLE_CLIENT_ID=
APP_PUBLIC_URL=https://yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
