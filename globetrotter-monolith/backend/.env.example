# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# development | production
# In production, missing JWT_SECRET or CORS_ORIGINS below will cause the
# app to refuse to start, rather than silently falling back to an
# insecure default — see config.py.
APP_ENV=development

# Flask's own debug mode. Leave unset — config.py already defaults this
# correctly based on APP_ENV (on for development, off for production).
# FLASK_DEBUG=false

PORT=5000

# Signs and verifies JWTs. Generate a real one for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production

# Leave empty for local SQLite. Production uses PostgreSQL.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Backs rate limiting. "memory://" works fine for a single process; once
# you run more than one backend worker/container, point this at a real
# Redis instance so all workers share the same rate-limit counters.
REDIS_URL=memory://

# Comma-separated list of origins allowed to call this API from a browser.
# Required in production (the app won't start without it there).
# Example production value:
#   CORS_ORIGINS=https://globetrotter.example.com,https://www.globetrotter.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# Whether cookies (if/when used) get the Secure flag. True in production
# (requires HTTPS), false for local HTTP development.
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
